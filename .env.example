# ROSEVERSE Atelier Production Environment Variables
# Configure these variables in Vercel Project Settings > Environment Variables

# App Environment
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://roseverse-website.vercel.app

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# AI Assistant API Endpoint (Optional Backend Proxy)
ROSEVERSE_AI_API_KEY=
ROSEVERSE_AI_API_ENDPOINT=
